{"title":"Microservices - Resilience & Metrics","uid":"ms-resilience","schemaVersion":39,"refresh":"5s","time":{"from":"now-15m","to":"now"},"panels":[
    {"id":1,"type":"timeseries","title":"Service up","datasource":{"type":"prometheus","uid":"prometheus"},
     "gridPos":{"h":8,"w":12,"x":0,"y":0},
     "targets":[{"expr":"up","legendFormat":"{{application}} {{name}} {{kind}}"}]}
,
    {"id":2,"type":"timeseries","title":"HTTP requests / s","datasource":{"type":"prometheus","uid":"prometheus"},
     "gridPos":{"h":8,"w":12,"x":12,"y":0},
     "targets":[{"expr":"sum by (application)(rate(http_server_requests_seconds_count[1m]))","legendFormat":"{{application}} {{name}} {{kind}}"}]}
,
    {"id":3,"type":"timeseries","title":"Circuit breaker state (1 = active)","datasource":{"type":"prometheus","uid":"prometheus"},
     "gridPos":{"h":8,"w":12,"x":0,"y":8},
     "targets":[{"expr":"resilience4j_circuitbreaker_state","legendFormat":"{{application}} {{name}} {{kind}}"}]}
,
    {"id":4,"type":"timeseries","title":"Circuit breaker calls / s","datasource":{"type":"prometheus","uid":"prometheus"},
     "gridPos":{"h":8,"w":12,"x":12,"y":8},
     "targets":[{"expr":"rate(resilience4j_circuitbreaker_calls_seconds_count[1m])","legendFormat":"{{application}} {{name}} {{kind}}"}]}
,
    {"id":5,"type":"timeseries","title":"Retry calls / s","datasource":{"type":"prometheus","uid":"prometheus"},
     "gridPos":{"h":8,"w":12,"x":0,"y":16},
     "targets":[{"expr":"rate(resilience4j_retry_calls_total[1m])","legendFormat":"{{application}} {{name}} {{kind}}"}]}
,
    {"id":6,"type":"timeseries","title":"Rate limiter waiting threads","datasource":{"type":"prometheus","uid":"prometheus"},
     "gridPos":{"h":8,"w":12,"x":12,"y":16},
     "targets":[{"expr":"resilience4j_ratelimiter_waiting_threads","legendFormat":"{{application}} {{name}} {{kind}}"}]}
,
    {"id":7,"type":"timeseries","title":"JVM heap used","datasource":{"type":"prometheus","uid":"prometheus"},
     "gridPos":{"h":8,"w":12,"x":0,"y":24},
     "targets":[{"expr":"sum by (application)(jvm_memory_used_bytes{area=\"heap\"})","legendFormat":"{{application}} {{name}} {{kind}}"}]}
,
    {"id":8,"type":"timeseries","title":"HTTP latency p95","datasource":{"type":"prometheus","uid":"prometheus"},
     "gridPos":{"h":8,"w":12,"x":12,"y":24},
     "targets":[{"expr":"histogram_quantile(0.95, sum by (le, application)(rate(http_server_requests_seconds_bucket[1m])))","legendFormat":"{{application}} {{name}} {{kind}}"}]}
]}
